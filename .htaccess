# Codeloop - Apache Configuration for XAMPP & PHP+Apache Docker
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ── 1. Canonical Domain: Redirect Render hostname to official domain ──
    RewriteCond %{HTTP_HOST} interview-hub-1-kvh8\.onrender\.com [NC,OR]
    RewriteCond %{HTTP:X-Forwarded-Host} interview-hub-1-kvh8\.onrender\.com [NC]
    RewriteRule ^(.*)$ https://codeloopyt.site/$1 [R=302,L,QSA]

    # ── 2. Health & API endpoints bypass rewriting ──
    RewriteRule ^healthz/?$ api/healthz.php [L,QSA]
    RewriteRule ^api/(.*)$ api/index.php [L,QSA]

    # ── 2b. Static asset fallback for nested routes (/blog/..., /admin/...) ──
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(?:blog|admin)/(.+\.(css|js|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf))$ $1 [L,NC]

    # ── 3. Strip index.php and index.html to root / ──
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.(php|html) [NC]
    RewriteRule ^index\.(php|html)$ / [R=302,L]

    # ── 4. Redirect nested admin/login path to /admin-login ──
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /admin/login(\.php)? [NC]
    RewriteRule ^admin/login(\.php)?$ /admin-login [R=302,L]

    # ── 5. Redirect blog article filenames to clean /blog/slug URLs ──
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /blog-([^.]+)\.html [NC]
    RewriteRule ^blog-([^.]+)\.html$ /blog/$1 [R=302,L]

    # ── 6. Redirect admin-users.html to clean /admin/users ──
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /admin-users\.html [NC]
    RewriteRule ^admin-users\.html$ /admin/users [R=302,L]

    # ── 7. Redirect direct requests with .php or .html extension to clean URLs ──
    # Exclude api directory and healthz
    RewriteCond %{REQUEST_URI} !^/api/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.php(\?|\ |\ HTTP) [NC]
    RewriteRule ^([^.]+)\.php$ /$1 [R=302,L,QSA]

    RewriteCond %{REQUEST_URI} !^/api/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html(\?|\ |\ HTTP) [NC]
    RewriteRule ^([^.]+)\.html$ /$1 [R=302,L,QSA]

    # ── 8. Internal Rewrites: Map clean URLs to actual files ──

    # Nested path: /admin/login -> admin-login.php
    RewriteRule ^admin/login/?$ admin-login.php [L,QSA]

    # Nested path: /admin/users -> admin-users.html
    RewriteRule ^admin/users/?$ admin-users.html [L]

    # Explicit blog article mappings
    RewriteRule ^blog/hr-interview-questions/?$ blog-hr-interview-questions.html [L]
    RewriteRule ^blog/crack-technical-interview/?$ blog-crack-technical-interview.html [L]
    RewriteRule ^blog/fresher-resume-tips/?$ blog-fresher-resume-tips.html [L]
    RewriteRule ^blog/java-interview-questions/?$ blog-java-interview-questions.html [L]
    RewriteRule ^blog/walk-in-interview-tips/?$ blog-walk-in-interview-tips.html [L]
    RewriteRule ^blog/aptitude-test-tips/?$ blog-aptitude-test-tips.html [L]

    # Nested path: /blog/slug -> blog-slug.html (if file exists)
    RewriteCond %{DOCUMENT_ROOT}/blog-$1.html -f
    RewriteRule ^blog/([^/]+)/?$ blog-$1.html [L]

    # Clean URL -> .php file if it exists (takes priority over .html)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]

    # Clean URL -> .html file if .php does not exist but .html exists
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [L]

</IfModule>

# Security: Block sensitive system files
<FilesMatch "(^\.env|\.git|composer\.|package(-lock)?\.json|server\.js|database\.js)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
